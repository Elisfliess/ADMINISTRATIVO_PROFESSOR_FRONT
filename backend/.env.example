# Copie este arquivo para .env e preencha com os dados do Supabase de desenvolvimento.
# Nunca coloque credenciais reais neste arquivo versionado.
# Use o host/porta/usuário do método de conexão escolhido no Supabase.
DB_URL=jdbc:postgresql://SEU_HOST:5432/postgres?sslmode=require
DB_USERNAME=SEU_USUARIO
DB_PASSWORD=SUA_SENHA

# Credenciais de migration (preencher somente para quem estiver autorizado).
# O perfil "migration" usa essas credenciais separadas das credenciais de runtime.
# FLYWAY_USERNAME=USUARIO_DE_MIGRACAO
# FLYWAY_PASSWORD=SENHA_DE_MIGRACAO

# Flyway fica desativado no uso diário. Para Supabase compartilhado, use o perfil migration
# e credenciais FLYWAY_* separadas, somente se estiver autorizado a aplicar migrations.
FLYWAY_ENABLED=false
